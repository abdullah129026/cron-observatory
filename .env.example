# Supabase (dashboard + API routes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared bearer secret for the pg_cron check tick (also stored in
# Supabase Vault for the pg_net call; see supabase/pg_cron_setup.sql)
CRON_SECRET=generate-a-long-random-string

# App origin, used for links inside Slack alert messages
NEXT_PUBLIC_APP_URL=http://localhost:3000
